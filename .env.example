# Required for live RERA registry lookups and optional Form M drafting
VITE_GEMINI_API_KEY=YOUR_API_KEY_HERE

# Feature flags (default false)
VITE_ENABLE_RERA_PROJECT_FETCH=false
VITE_ENABLE_RERA_FORM_M_DRAFT=false
VITE_ENABLE_INSTALLMENTS_SCHEDULE=false

# ─── Firebase Web SDK (public-safe — not secrets) ─────────────────────────────
# Get these from Firebase Console > Project Settings > Your apps > Config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Razorpay (public key only — secret stays on server) ─────────────────────
# Get from Razorpay Dashboard > Settings > API Keys (test mode: rzp_test_*)
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# ─── Render Backend API ───────────────────────────────────────────────────────
# URL of your deployed rera-hub-api service on Render (no trailing slash)
# Leave blank during local dev if you haven't set up the backend yet
VITE_RENDER_API_URL=https://rera-hub-api.onrender.com
